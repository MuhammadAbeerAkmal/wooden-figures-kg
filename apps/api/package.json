{
  "name": "@wfkg/api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/main.js",
    "start:dev": "npm run build && node --watch dist/main.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.spec.js\"",
    "seed": "npm run build && node dist/scripts/seed.js",
    "rdf:export": "npm run build && node dist/scripts/rdf-export.js",
    "rdf:load": "npm run build && node dist/scripts/rdf-load.js",
    "rdf:validate": "npm run build && node dist/scripts/rdf-validate.js",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "better-sqlite3": "^12.11.1",
    "n3": "^2.13.12",
    "rdf-validate-shacl": "^0.6.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
