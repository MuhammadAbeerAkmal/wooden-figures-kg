# Copy to .env to override the defaults. Docker Compose reads .env automatically.
# For local development (npm run dev:api) the defaults in apps/api/src/config.ts are used
# unless these variables are set in your shell.

# Host ports published by Docker Compose
WEB_PORT=8080
API_PORT=3000
OXIGRAPH_PORT=7878

# API settings (local development values)
PORT=3000
DATABASE_PATH=./data/figures.sqlite
SPARQL_ENDPOINT=http://localhost:7878
# Insert the fictional seed data when the database is empty
SEED_ON_START=true
# Convert the relational data to RDF and load it into Oxigraph on start
LOAD_RDF_ON_START=true
